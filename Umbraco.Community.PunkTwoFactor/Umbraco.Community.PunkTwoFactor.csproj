<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<StaticWebAssetBasePath>App_Plugins/punkTwoFactor</StaticWebAssetBasePath>
		<Version>18.3.2.5</Version>
		<Product>Umbraco.Community.PunkTwoFactor</Product>
		<PackageId>Umbraco.Community.PunkTwoFactor</PackageId>
		<Title>Umbraco.Community.PunkTwoFactor</Title>
		<Description>An app_plugin for Umbraco that sets up Two Factor Authentication.</Description>
		<PackageTags>umbraco;umbraco-marketplace;2fa;two-factor-authentication</PackageTags>
		<RootNamespace>Umbraco.Community.PunkTwoFactor</RootNamespace>
		<Authors>Gareth Wright</Authors>
		<PackageProjectUrl>https://github.com/garpunkal/Umbraco.Community.PunkTwoFactor</PackageProjectUrl>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageIcon>logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/garpunkal/Umbraco.Community.PunkTwoFactor</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="GoogleAuthenticator" Version="3.2.0" />
		<PackageReference Include="Umbraco.Cms.Core" Version="18.2.1" />
		<PackageReference Include="Umbraco.Cms.Api.Management" Version="18.2.1" />
		<PackageReference Include="Umbraco.Cms.Web.Website" Version="18.2.1" />
		<PackageReference Include="Umbraco.Cms.Web.Common" Version="18.2.1" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE" Pack="true" PackagePath="" />
		<None Include="..\logo.png" Pack="true" PackagePath="" />
	</ItemGroup>
</Project>  
